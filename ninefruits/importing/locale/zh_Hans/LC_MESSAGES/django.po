# key: validation.required
#: ninefruits/importing/resources.py
#, python-format
msgid "The %(attribute)s field is required."
msgstr "%(attribute)s 不能为空。"

# key: validation.after_or_equal
#: ninefruits/importing/resources.py
#, python-format
msgid "The %(attribute)s field must be a date after or equal to %(date)s."
msgstr "%(attribute)s 必须要等于 %(date)s 或更晚。"

# key: validation.max.string
#: ninefruits/importing/resources.py
#, python-format
msgid "The %(attribute)s field must not be greater than %(max)s characters."
msgstr "%(attribute)s 不能大于 %(max)s 个字符。"

# key: validation.enum
#: ninefruits/importing/resources.py
#, python-format
msgid "The selected %(attribute)s is invalid."
msgstr "%(attribute)s 值不正确。"

# key: validation.integer
#: ninefruits/importing/resources.py
#, python-format
msgid "The %(attribute)s field must be an integer."
msgstr "%(attribute)s 必须是整数。"

# key: validation.numeric
#: ninefruits/importing/resources.py
#, python-format
msgid "The %(attribute)s field must be a number."
msgstr "%(attribute)s 必须是一个数字。"

# key: validation.boolean
#: ninefruits/importing/resources.py
#, python-format
msgid "The %(attribute)s field must be true or false."
msgstr "%(attribute)s 必须为布尔值。"

# key: validation.date
#: ninefruits/importing/resources.py
#, python-format
msgid "The %(attribute)s field must be a valid date."
msgstr "%(attribute)s 不是一个有效的日期。"

# key: validation.between.numeric
#: ninefruits/importing/resources.py
#, python-format
msgid "The %(attribute)s field must be between %(min)s and %(max)s."
msgstr "%(attribute)s 必须介于 %(min)s - %(max)s 之间。"

# key: validation.min.numeric
#: ninefruits/importing/resources.py
#, python-format
msgid "The %(attribute)s field must be at least %(min)s."
msgstr "%(attribute)s 必须大于等于 %(min)s。"

# key: reference.import.unknown_code
#: ninefruits/importing/resources.py
#, python-format
msgid "Unknown %(column)s code \"%(code)s\"."
msgstr "未知的 %(column)s 代码 \"%(code)s\"。"


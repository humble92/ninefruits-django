msgstr "Le champ %(attribute)s doit être un entier."

# key: validation.numeric
#: ninefruits/importing/resources.py
#, python-format
msgid "The %(attribute)s field must be a number."
msgstr "Le champ %(attribute)s doit être un nombre."

# key: validation.boolean
#: ninefruits/importing/resources.py
#, python-format

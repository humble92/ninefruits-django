# key: certificate.settings.serial_pattern_help
#: ninefruits/certificate/settings_pages.py
#, python-brace-format
msgid "Tokens: {TYPE} kind code, {YYYY} or {YY} year, {SEQ:6} sequence padded to 6 digits (required). The sequence restarts for each distinct prefix, so {TYPE}-{YYYY}-{SEQ:6} counts per kind and year."
msgstr "Mga token: {TYPE} code ng uri, {YYYY} o {YY} taon, {SEQ:6} sunud-sunod na numerong may 6 na digit (kinakailangan). Nagsisimula muli ang pagkakasunod sa bawat natatanging prefix, kaya ang {TYPE}-{YYYY}-{SEQ:6} ay nagbibilang bawat uri at taon."


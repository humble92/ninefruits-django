# key: security.errors.cannot_deactivate_self
#: actions/accounts.py
msgid "You cannot deactivate your own account."
msgstr "ທ່ານບໍ່ສາມາດປິດໃຊ້ບັນຊີຂອງຕົນເອງໄດ້."

# key: security.errors.target_more_privileged
#: actions/accounts.py
#, python-format
msgid ""
"This account holds permissions you do not have (%(permissions)s); only an "
"administrator with those permissions can change it."
msgstr "ບັນຊີນີ້ມີສິດທີ່ທ່ານບໍ່ມີ (%(permissions)s); ສະເພາະຜູ້ບໍລິຫານທີ່ມີສິດເຫຼົ່ານັ້ນເທົ່ານັ້ນຈຶ່ງປ່ຽນແປງໄດ້."

# key: json.The provided password does not match your current password.
#: actions/accounts.py
msgid "The provided password does not match your current password."
msgstr "ລະຫັດຜ່ານທີ່ປ້ອນບໍ່ກົງກັບລະຫັດຜ່ານປັດຈຸບັນຂອງທ່ານ."

#: actions/accounts.py
msgid "The password field confirmation does not match."
msgstr "ການຢືນຢັນລະຫັດຜ່ານບໍ່ກົງກັນ."

#: actions/accounts.py admin.py
msgid "The email has already been taken."
msgstr "ອີເມວນີ້ຖືກໃຊ້ແລ້ວ."

# key: security.errors.persona_role_not_assignable
#: actions/assign_role.py
msgid "Persona roles are granted automatically and cannot be assigned."
msgstr "ບົດບາດຕາມສະຖານະຜູ້ໃຊ້ຖືກມອບໂດຍອັດຕະໂນມັດ ແລະ ບໍ່ສາມາດມອບດ້ວຍຕົນເອງໄດ້."

# key: security.errors.scope_id_mismatch
#: actions/assign_role.py admin.py
msgid ""
"Choose a scope target for scoped assignments, and none for global "
"assignments."
msgstr "ກະລຸນາເລືອກເປົ້າໝາຍຂອບເຂດສຳລັບການມອບແບບມີຂອບເຂດ, ແລະ ບໍ່ເລືອກສຳລັບການມອບແບບທົ່ວໄປ."

# key: offering.errors.meeting_time_order
#: actions/assign_role.py admin.py
msgid "The end must be after the start."
msgstr "ເວລາສິ້ນສຸດຕ້ອງຢູ່ຫຼັງເວລາເລີ່ມ."

# key: security.errors.self_assignment
#: actions/assign_role.py
msgid "You cannot assign a role to yourself."
msgstr "ທ່ານບໍ່ສາມາດມອບບົດບາດໃຫ້ຕົນເອງໄດ້."

# key: security.errors.role_exceeds_actor
#: actions/assign_role.py
#, python-format
msgid "This role carries permissions you do not hold (%(permissions)s)."
msgstr "ບົດບາດນີ້ມີສິດທີ່ທ່ານບໍ່ມີ (%(permissions)s)."

# key: security.errors.scope_exceeds_actor
#: actions/assign_role.py
msgid "This scope is wider than the one you manage role assignments for."
msgstr "ຂອບເຂດນີ້ກວ້າງກວ່າຂອບເຂດທີ່ທ່ານຈັດການການມອບບົດບາດ."

# key: security.sso.linked_to_another_account
#: actions/identities.py
msgid "This school account is linked to another user."
msgstr "ບັນຊີຂອງສະຖາບັນນີ້ເຊື່ອມຕໍ່ກັບຜູ້ໃຊ້ອື່ນຢູ່ແລ້ວ."

# key: security.sso.already_linked
#: actions/identities.py
msgid "Your account is already linked to another account of this provider."
msgstr "ບັນຊີຂອງທ່ານເຊື່ອມຕໍ່ກັບບັນຊີອື່ນຂອງຜູ້ໃຫ້ບໍລິການນີ້ຢູ່ແລ້ວ."

# key: json.The provided two factor authentication code was invalid.
#: actions/mfa.py
msgid "The provided two factor authentication code was invalid."
msgstr "ລະຫັດຢືນຢັນສອງຂັ້ນຕອນທີ່ປ້ອນບໍ່ຖືກຕ້ອງ."

#: actions/mfa.py
msgid "Recovery codes need an authenticator app. Set one up first."
msgstr "ລະຫັດກູ້ຄືນຕ້ອງມີແອັບຢືນຢັນຕົວຕົນ. ກະລຸນາຕັ້ງຄ່າກ່ອນ."

# key: security.email_code.not_allowed
#: actions/mfa.py
msgid "Email codes are not available at this institution."
msgstr "ລະຫັດທາງອີເມວບໍ່ມີໃຫ້ໃຊ້ໃນສະຖາບັນນີ້."

# key: security.email_code.invalid
#: actions/mfa.py views.py
msgid "The code is invalid or has expired."
msgstr "ລະຫັດບໍ່ຖືກຕ້ອງ ຫຼື ໝົດອາຍຸແລ້ວ."

# key: security.mfa.cannot_disable_required
#: actions/mfa.py
msgid ""
"Two-factor authentication is required for your account and cannot be "
"disabled."
msgstr "ບັນຊີຂອງທ່ານຈຳເປັນຕ້ອງໃຊ້ການຢືນຢັນສອງຂັ້ນຕອນ ແລະ ບໍ່ສາມາດປິດໃຊ້ໄດ້."

# key: auth.failed
#: adapters.py
msgid "These credentials do not match our records."
msgstr "ຂໍ້ມູນເຂົ້າລະບົບບໍ່ກົງກັບບັນທຶກຂອງພວກເຮົາ."

#: adapters.py
msgid "Too many login attempts. Please try again later."
msgstr "ພະຍາຍາມເຂົ້າສູ່ລະບົບຫຼາຍເກີນໄປ. ກະລຸນາລອງໃໝ່ພາຍຫຼັງ."


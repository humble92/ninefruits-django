# key: security.errors.cannot_deactivate_self
#: ninefruits/security/actions/accounts.py
msgid "You cannot deactivate your own account."
msgstr "Anda tidak boleh menyahaktifkan akaun anda sendiri."

# key: security.errors.target_more_privileged
#: ninefruits/security/actions/accounts.py
#, python-format
msgid "This account holds permissions you do not have (%(permissions)s); only an administrator with those permissions can change it."
msgstr "Akaun ini mempunyai kebenaran yang anda tidak miliki (%(permissions)s); hanya pentadbir yang mempunyai kebenaran tersebut boleh mengubahnya."

# key: json.The provided password does not match your current password.
#: ninefruits/security/actions/accounts.py
msgid "The provided password does not match your current password."
msgstr "Kata laluan yang diberikan tidak sepadan dengan kata laluan semasa anda."


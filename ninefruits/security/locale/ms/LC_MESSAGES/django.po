msgid "The email has already been taken."
msgstr "E-mel ini telah digunakan."

# key: security.errors.persona_role_not_assignable
#: ninefruits/security/actions/assign_role.py
msgid "Persona roles are granted automatically and cannot be assigned."
msgstr "Peranan persona diberikan secara automatik dan tidak boleh ditetapkan."

# key: security.errors.scope_id_mismatch
#: ninefruits/security/actions/assign_role.py ninefruits/security/admin.py
msgid "Choose a scope target for scoped assignments, and none for global assignments."
msgstr "Pilih sasaran skop bagi penetapan berskop, dan tiada sasaran bagi penetapan global."

# key: offering.errors.meeting_time_order
#: ninefruits/security/actions/assign_role.py ninefruits/security/admin.py
msgid "The end must be after the start."
msgstr "Masa tamat mestilah selepas masa mula."

# key: security.errors.self_assignment
#: ninefruits/security/actions/assign_role.py
msgid "You cannot assign a role to yourself."
msgstr "Anda tidak boleh menetapkan peranan kepada diri sendiri."

# key: security.errors.role_exceeds_actor
#: ninefruits/security/actions/assign_role.py
#, python-format
msgid "This role carries permissions you do not hold (%(permissions)s)."
msgstr "Peranan ini mengandungi kebenaran yang anda tidak miliki (%(permissions)s)."

# key: security.errors.scope_exceeds_actor
#: ninefruits/security/actions/assign_role.py
msgid "This scope is wider than the one you manage role assignments for."
msgstr "Skop ini lebih luas daripada skop penetapan peranan yang anda uruskan."

# key: security.sso.linked_to_another_account

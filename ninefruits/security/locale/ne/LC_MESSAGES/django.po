msgstr "दुई-चरण प्रमाणीकरण"

# key: admin.settings.security.mfa_description
#: ninefruits/security/settings_pages.py
msgid "Changes apply to every user immediately."
msgstr "परिवर्तनहरू सबै प्रयोगकर्तामा तुरुन्तै लागू हुन्छन्।"

#: ninefruits/security/settings_pages.py
#, python-format
msgid "%(key)s: the key uses lowercase letters, digits and hyphens."
msgstr "%(key)s: कुञ्जीमा साना अङ्ग्रेजी अक्षर, अङ्क र हाइफन मात्र हुन्छन्।"

#: ninefruits/security/settings_pages.py
#, python-format
msgid "%(key)s: each provider needs its own key."
msgstr "%(key)s: प्रत्येक प्रदायकको आफ्नै कुञ्जी चाहिन्छ।"

#: ninefruits/security/settings_pages.py
#, python-format
msgid "%(key)s: the button label is required (64 characters at most)."
msgstr "%(key)s: बटनको लेबल आवश्यक छ (बढीमा 64 अक्षर)।"

#: ninefruits/security/settings_pages.py
#, python-format
msgid "%(key)s: the issuer must be a URL."
msgstr "%(key)s: जारीकर्ता URL हुनुपर्छ।"

#: ninefruits/security/settings_pages.py
#, python-format
msgid "%(key)s: the client ID is required."
msgstr "%(key)s: क्लाइन्ट ID आवश्यक छ।"

# key: admin.settings.authentication.student_number_login
#: ninefruits/security/settings_pages.py
msgid "Sign in with student number"
msgstr "विद्यार्थी नम्बरले साइन इन"

# key: admin.settings.authentication.password_login_for_sso_users
#: ninefruits/security/settings_pages.py
msgid "Allow passwords for users with school sign-in"
msgstr "विद्यालय साइन इन भएका प्रयोगकर्तालाई पासवर्ड अनुमति दिनुहोस्"

# key: admin.settings.authentication.password_login_for_sso_users_help
#: ninefruits/security/settings_pages.py
msgid "When off, users who have linked a school account must use it to sign in."
msgstr "बन्द हुँदा, विद्यालय खाता जोडेका प्रयोगकर्ताले साइन इन गर्न त्यही खाता प्रयोग गर्नुपर्छ।"

# key: admin.settings.authentication.lockout_threshold
#: ninefruits/security/settings_pages.py
msgid "Lock after failed attempts"
msgstr "असफल प्रयासपछि लक गर्नुहोस्"

# key: admin.settings.authentication.lockout_threshold_help
#: ninefruits/security/settings_pages.py
msgid "Failed passwords in a row before the account is locked. 0 turns locking off."
msgstr "खाता लक हुनुअघि लगातार गलत पासवर्डको सङ्ख्या। 0 ले लक बन्द गर्छ।"


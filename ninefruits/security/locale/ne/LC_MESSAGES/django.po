msgstr "उपकरण सम्झने अवधि (दिन)"

# key: admin.settings.security.mfa_remember_device_help
#: ninefruits/security/settings_pages.py
msgid "Users can skip the code on a trusted device for this many days. 0 turns this off."
msgstr "विश्वसनीय उपकरणमा प्रयोगकर्ताले यति दिनसम्म कोड नहाली साइन इन गर्न सक्छन्। 0 ले यो बन्द गर्छ।"

# key: admin.settings.security.mfa_email_code_enabled
#: ninefruits/security/settings_pages.py
msgid "Allow email codes"
msgstr "इमेल कोड अनुमति दिनुहोस्"

# key: admin.settings.security.mfa_email_code_help
#: ninefruits/security/settings_pages.py
msgid "Users can choose one-time codes by email instead of an authenticator app. Turning this off stops email codes from counting as two-factor authentication."
msgstr "प्रयोगकर्ताले प्रमाणीकरण एपको सट्टा इमेलबाट एक पटके कोड रोज्न सक्छन्। यो बन्द गर्दा इमेल कोडलाई दुई-चरण प्रमाणीकरण मानिँदैन।"

#: ninefruits/security/settings_pages.py
msgid "Choose at least one role."
msgstr "कम्तीमा एउटा भूमिका छान्नुहोस्।"


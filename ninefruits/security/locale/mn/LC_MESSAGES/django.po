#: ninefruits/security/settings_pages.py
msgid "Failed passwords in a row before the account is locked. 0 turns locking off."
msgstr "Бүртгэлийг түгжихээс өмнө дараалан буруу оруулж болох нууц үгийн тоо. 0 бол түгжихгүй."

# key: admin.settings.authentication.lockout_minutes

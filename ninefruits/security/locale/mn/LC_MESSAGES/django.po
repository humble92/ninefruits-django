#: ninefruits/security/views.py
msgid "The email code must be 6 digits."
msgstr "Имэйлийн код 6 оронтой тоо байх ёстой."

# key: security.email_code.sent
#: ninefruits/security/views.py
msgid "A new code has been sent to your email."
msgstr "Таны и-мэйл рүү шинэ код илгээлээ."

# key: security.email_code.wait
#: ninefruits/security/views.py
#, python-format
msgid "Please wait %(seconds)s seconds before requesting another code."
msgstr "Дахин код хүсэхээс өмнө %(seconds)s секунд хүлээнэ үү."

# key: security.sso.failed
#: ninefruits/security/views_sso.py
msgid "School sign-in failed. Try again or sign in with your password."
msgstr "Сургуулийн нэвтрэлт амжилтгүй боллоо. Дахин оролдох эсвэл нууц үгээрээ нэвтэрнэ үү."

# key: security.sso.expired
#: ninefruits/security/views_sso.py
msgid "The sign-in attempt expired. Try again."
msgstr "Нэвтрэх оролдлогын хугацаа дууссан. Дахин оролдоно уу."

# key: security.sso.cancelled
#: ninefruits/security/views_sso.py
msgid "Sign-in was cancelled."
msgstr "Нэвтрэлтийг цуцаллаа."

# key: security.sso.linked
#: ninefruits/security/views_sso.py
#, python-format
msgid "%(provider)s account linked."
msgstr "%(provider)s бүртгэл холбогдлоо."

# key: security.sso.not_linked
#: ninefruits/security/views_sso.py
#, python-format
msgid "Your %(provider)s account is not linked to an account here. Sign in with your password and link it under Security."
msgstr "Таны %(provider)s бүртгэл энд бүртгэлтэй холбогдоогүй байна. Нууц үгээрээ нэвтэрч, Аюулгүй байдал хэсэгт холбоно уу."


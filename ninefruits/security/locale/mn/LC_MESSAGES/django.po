# key: security.errors.cannot_deactivate_self
#: ninefruits/security/actions/accounts.py
msgid "You cannot deactivate your own account."
msgstr "Та өөрийн бүртгэлийг идэвхгүй болгох боломжгүй."

# key: security.errors.target_more_privileged
#: ninefruits/security/actions/accounts.py
#, python-format
msgid "This account holds permissions you do not have (%(permissions)s); only an administrator with those permissions can change it."
msgstr "Энэ бүртгэл танд байхгүй эрхтэй (%(permissions)s); зөвхөн тэдгээр эрхтэй админ өөрчилж болно."

# key: json.The provided password does not match your current password.
#: ninefruits/security/actions/accounts.py
msgid "The provided password does not match your current password."
msgstr "Оруулсан нууц үг таны одоогийн нууц үгтэй таарахгүй байна."

#: ninefruits/security/actions/accounts.py
msgid "The password field confirmation does not match."
msgstr "Нууц үгийн баталгаажуулалт таарахгүй байна."

#: ninefruits/security/actions/accounts.py ninefruits/security/admin.py
msgid "The email has already been taken."
msgstr "Энэ имэйл аль хэдийн бүртгэгдсэн байна."

# key: security.errors.persona_role_not_assignable
#: ninefruits/security/actions/assign_role.py
msgid "Persona roles are granted automatically and cannot be assigned."
msgstr "Дүрийн үүргийг автоматаар олгодог тул оноох боломжгүй."

# key: security.errors.scope_id_mismatch
#: ninefruits/security/actions/assign_role.py ninefruits/security/admin.py
msgid "Choose a scope target for scoped assignments, and none for global assignments."
msgstr "Хамрах хүрээтэй оноолтод хамрах хүрээний объект сонгож, бүх нийтийн оноолтод сонгохгүй байна уу."

# key: offering.errors.meeting_time_order
#: ninefruits/security/actions/assign_role.py ninefruits/security/admin.py
msgid "The end must be after the start."
msgstr "Дуусах цаг эхлэх цагаас хойш байх ёстой."

# key: security.errors.self_assignment
#: ninefruits/security/actions/assign_role.py
msgid "You cannot assign a role to yourself."
msgstr "Та өөртөө үүрэг оноох боломжгүй."

# key: security.errors.role_exceeds_actor
#: ninefruits/security/actions/assign_role.py
#, python-format
msgid "This role carries permissions you do not hold (%(permissions)s)."
msgstr "Энэ үүрэг танд байхгүй эрх агуулж байна (%(permissions)s)."

# key: security.errors.scope_exceeds_actor
#: ninefruits/security/actions/assign_role.py

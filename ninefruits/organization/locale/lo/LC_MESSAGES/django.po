# key: reference.errors.successor_required
#: ninefruits/organization/actions/reorganize_org_unit.py
msgid "Choose the successor unit."
msgstr "ກະລຸນາເລືອກໜ່ວຍງານສືບທອດ."

# key: reference.errors.single_successor
#: ninefruits/organization/actions/reorganize_org_unit.py ninefruits/organization/admin.py
msgid "Only a split can have several successors."
msgstr "ສະເພາະການແຍກເທົ່ານັ້ນຈຶ່ງມີໜ່ວຍງານສືບທອດຫຼາຍອັນໄດ້."

# key: reference.errors.reorganization_before_start
#: ninefruits/organization/actions/reorganize_org_unit.py
msgid "The effective date must be after the unit started."
msgstr "ວັນທີມີຜົນຕ້ອງຢູ່ຫຼັງວັນທີທີ່ໜ່ວຍງານເລີ່ມ."

# key: reference.errors.successor_is_self
#: ninefruits/organization/actions/reorganize_org_unit.py
msgid "A unit cannot succeed itself."
msgstr "ໜ່ວຍງານບໍ່ສາມາດສືບທອດຕົນເອງໄດ້."


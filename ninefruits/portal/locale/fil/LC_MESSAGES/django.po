# key: admin.settings.security.mfa_section
# key: authentication.two_factor.title
# key: security.mfa.title
#: ninefruits/portal/templates/portal/security.html ninefruits/portal/views/security.py
msgid "Two-factor authentication"
msgstr "Two-factor authentication"

# key: security.mfa.description
#: ninefruits/portal/templates/portal/security.html
msgid "Two-factor authentication protects your account with a code from an authenticator app in addition to your password."
msgstr "Pinoprotektahan ng two-factor authentication ang iyong account gamit ang code mula sa authenticator app bukod pa sa iyong password."

# key: security.mfa.enrollment_required
#: ninefruits/portal/templates/portal/security.html
msgid "Two-factor authentication is required for your account. Please set it up to continue."
msgstr "Kinakailangan ang two-factor authentication para sa iyong account. Pakiset-up ito para magpatuloy."

# key: security.mfa_methods.authenticator_app
#: ninefruits/portal/templates/portal/security.html
msgid "Authenticator app"
msgstr "Authenticator app"

# key: security.mfa.enabled
#: ninefruits/portal/templates/portal/security.html
msgid "Two-factor authentication is enabled."
msgstr "Naka-enable ang two-factor authentication."

# key: security.mfa.regenerate_recovery_codes
#: ninefruits/portal/templates/portal/security.html
msgid "Generate new recovery codes"
msgstr "Bumuo ng mga bagong recovery code"

# key: security.mfa.disable_confirm
#: ninefruits/portal/templates/portal/security.html
msgid "Disable two-factor authentication?"
msgstr "I-disable ang two-factor authentication?"

# key: security.mfa.disable
#: ninefruits/portal/templates/portal/security.html
msgctxt "security"
msgid "Disable"
msgstr "I-disable"

# key: security.mfa.scan_qr_code
#: ninefruits/portal/templates/portal/security.html
msgid "Scan this QR code with your authenticator app, then enter the code it shows."
msgstr "I-scan ang QR code na ito gamit ang iyong authenticator app, pagkatapos ay ilagay ang code na ipinapakita nito."

# key: security.mfa.setup_key
#: ninefruits/portal/templates/portal/security.html
msgid "Setup key"
msgstr "Setup key"

# key: authentication.two_factor.code
#: ninefruits/portal/templates/portal/security.html
msgctxt "authentication"
msgid "Code"
msgstr "Code"

# key: authentication.confirm_password.submit
# key: security.mfa.confirm
#: ninefruits/portal/templates/portal/security.html
msgctxt "security"
msgid "Confirm"
msgstr "Kumpirmahin"

# key: security.mfa.enable
#: ninefruits/portal/templates/portal/security.html
msgid "Enable two-factor authentication"
msgstr "I-enable ang two-factor authentication"

# key: security.mfa.recovery_codes_instructions
#: ninefruits/portal/templates/portal/security.html
msgid "Store these recovery codes in a safe place. Each can be used once if you lose your device."
msgstr "Itago ang mga recovery code na ito sa ligtas na lugar. Maaaring gamitin nang isang beses ang bawat isa kung mawala ang iyong device."

# key: authentication.two_factor.email_code
# key: security.mfa_methods.email_code
#: ninefruits/portal/templates/portal/security.html
msgid "Email code"
msgstr "Code sa email"

# key: security.email_code.description
#: ninefruits/portal/templates/portal/security.html
#, python-format
msgid "Receive a one-time code at %(email)s each time you sign in. Less secure than an authenticator app; use it if you cannot install one."
msgstr "Makatanggap ng one-time code sa %(email)s tuwing magsa-sign in ka. Hindi kasing-ligtas ng authenticator app; gamitin ito kung hindi ka makapag-install nito."

# key: security.email_code.enabled
#: ninefruits/portal/templates/portal/security.html
msgid "Email codes are turned on."
msgstr "Naka-on ang mga code sa email."

# key: security.email_code.disable_confirm
#: ninefruits/portal/templates/portal/security.html
msgid "Turn off email codes?"
msgstr "I-off ang mga code sa email?"

# key: authentication.two_factor.email_code
#: ninefruits/portal/templates/portal/security.html
msgctxt "authentication"
msgid "Email code"
msgstr "Code sa email"

# key: authentication.two_factor.resend_email_code
#: ninefruits/portal/templates/portal/security.html
msgid "Send a new code"
msgstr "Magpadala ng bagong code"

# key: security.email_code.enable
#: ninefruits/portal/templates/portal/security.html
msgid "Send a code to set up"
msgstr "Magpadala ng code para i-set up"

#: ninefruits/portal/templates/portal/security.html
msgid "Remembered devices"
msgstr "Mga natandaang device"

#: ninefruits/portal/templates/portal/security.html
#, python-format
msgid "When you tick \"Remember this device\" at sign-in, this browser skips the code for %(days)s day."
msgid_plural "When you tick \"Remember this device\" at sign-in, this browser skips the code for %(days)s days."
msgstr[0] "Kapag nilagyan mo ng tsek ang \"Tandaan ang device na ito\" sa pag-sign in, lalaktawan ng browser na ito ang code sa loob ng %(days)s araw."
msgstr[1] "Kapag nilagyan mo ng tsek ang \"Tandaan ang device na ito\" sa pag-sign in, lalaktawan ng browser na ito ang code sa loob ng %(days)s araw."

#: ninefruits/portal/templates/portal/security.html
msgid "Changing your two-factor setup forgets every remembered device."
msgstr "Ang pagbabago sa iyong two-factor setup ay magpapalimot sa lahat ng natandaang device."

#: ninefruits/portal/templates/portal/security.html
msgid "Forget this device"
msgstr "Kalimutan ang device na ito"

#: ninefruits/portal/templates/portal/security.html
msgid "This device is not remembered."
msgstr "Hindi natatandaan ang device na ito."

#: ninefruits/portal/templates/portal/security.html
msgid "Change password"
msgstr "Palitan ang password"

#: ninefruits/portal/templates/portal/security.html
msgid "Your password was changed. Other sessions were signed out."
msgstr "Napalitan na ang iyong password. Na-sign out ang iba pang session."

#: ninefruits/portal/templates/portal/security.html
msgid "Current password"
msgstr "Kasalukuyang password"

# key: authentication.fields.new_password
#: ninefruits/portal/templates/portal/security.html
msgid "New password"
msgstr "Bagong password"

# key: authentication.fields.password_confirmation
#: ninefruits/portal/templates/portal/security.html
msgid "Confirm password"
msgstr "Kumpirmahin ang password"

# key: security.sso.title
#: ninefruits/portal/templates/portal/security.html
msgid "School sign-in"
msgstr "School sign-in"

# key: security.sso.help
#: ninefruits/portal/templates/portal/security.html
msgid "Link your school account to sign in with it."
msgstr "I-link ang iyong account ng paaralan para mag-sign in gamit ito."

# key: lms.link_statuses.linked
# key: security.sso.linked_status
#: ninefruits/portal/templates/portal/security.html
msgid "Linked"
msgstr "Naka-link"

# key: security.sso.unlink_confirm
#: ninefruits/portal/templates/portal/security.html
msgid "Unlink this school account? You will need your password to sign in."
msgstr "I-unlink ang account ng paaralan na ito? Kakailanganin mo ang iyong password para mag-sign in."

# key: security.sso.unlink
#: ninefruits/portal/templates/portal/security.html
msgid "Unlink"
msgstr "I-unlink"

# key: security.sso.link
#: ninefruits/portal/templates/portal/security.html
msgctxt "security"
msgid "Link"
msgstr "I-link"

# key: security.mfa.required_by
#: ninefruits/portal/templatetags/portal.py
#, python-format
msgctxt "security"
msgid "Two-factor authentication is required for your account. Please set it up by %(date)s."
msgstr "Kinakailangan ang two-factor authentication para sa iyong account. Pakiset-up ito bago o sa %(date)s."

# key: security.mfa.recommended
#: ninefruits/portal/templatetags/portal.py
msgctxt "security"
msgid "We recommend enabling two-factor authentication for your account."
msgstr "Inirerekomenda naming i-enable ang two-factor authentication para sa iyong account."

#: ninefruits/portal/views/security.py
msgid "Start the setup again."
msgstr "Simulan muli ang setup."

#: ninefruits/portal/views/security.py
msgid "The code must be 6 digits."
msgstr "Ang code ay dapat 6 na digit."

# key: security.email_code.not_allowed
#: ninefruits/portal/views/security.py
msgid "Email codes are not available at this institution."
msgstr "Hindi available ang mga code sa email sa institusyong ito."

# key: security.email_code.wait
#: ninefruits/portal/views/security.py
#, python-format
msgid "Please wait %(seconds)s seconds before requesting another code."
msgstr "Pakihintay ang %(seconds)s segundo bago humiling ng ibang code."

#: ninefruits/portal/views/security.py
msgid "The email code must be 6 digits."
msgstr "Ang email code ay dapat 6 na digit."

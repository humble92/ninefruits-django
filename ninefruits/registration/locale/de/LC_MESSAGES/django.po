# key: registration.rules.window.description
#: ninefruits/registration/enums.py
msgid "A registration, add/drop or withdrawal period must be open for the student."
msgstr "Für die/den Studierende/n muss ein Belegungs-, Änderungs- oder Rücktrittszeitraum offen sein."

# key: registration.rules.section_open.description
#: ninefruits/registration/enums.py
msgid "The section must be published."
msgstr "Der Kurs muss veröffentlicht sein."

# key: registration.rules.hold.description
#: ninefruits/registration/enums.py
msgid "Students with a hold that blocks registration cannot register."
msgstr "Studierende mit einer Sperre, die die Belegung verhindert, können nicht belegen."

# key: registration.rules.student_status.description
#: ninefruits/registration/enums.py
msgid "Only students with the chosen statuses may register."
msgstr "Nur Studierende mit den gewählten Status dürfen belegen."

# key: registration.rules.eligibility.description
#: ninefruits/registration/enums.py
msgid "The student must match the section's eligibility and not its exclusions."
msgstr "Die/der Studierende muss die Berechtigung des Kurses erfüllen und darf nicht unter seine Ausschlüsse fallen."

# key: registration.rules.duplicate_course.description
#: ninefruits/registration/enums.py
msgid "A course can be registered only once per term."
msgstr "Eine Lehrveranstaltung kann je Semester nur einmal belegt werden."

# key: registration.rules.time_conflict.description
#: ninefruits/registration/enums.py
msgid "Meeting times must not overlap with other registered sections."
msgstr "Die Kurszeiten dürfen sich nicht mit anderen belegten Kursen überschneiden."

# key: registration.rules.credit_limit.description
#: ninefruits/registration/enums.py
msgid "Total credits must not exceed the credit limit that applies to the student."
msgstr "Die Summe der Leistungspunkte darf die für die/den Studierende/n geltende Obergrenze nicht überschreiten."

# key: registration.rules.requisites.description
#: ninefruits/registration/enums.py

# key: registration.rules.section_open.description
#: enums.py:107
msgid "The section must be published."
msgstr "ກຸ່ມຮຽນຕ້ອງຖືກເຜີຍແຜ່ແລ້ວ."

# key: registration.rules.hold.description
#: enums.py:108
msgid "Students with a hold that blocks registration cannot register."
msgstr "ນັກສຶກສາທີ່ມີການລະງັບທີ່ຂັດຂວາງການລົງທະບຽນບໍ່ສາມາດລົງທະບຽນໄດ້."

# key: registration.rules.student_status.description
#: enums.py:109
msgid "Only students with the chosen statuses may register."
msgstr "ສະເພາະນັກສຶກສາທີ່ມີສະຖານະທີ່ເລືອກເທົ່ານັ້ນຈຶ່ງລົງທະບຽນໄດ້."

# key: registration.rules.eligibility.description
#: enums.py:110
msgid "The student must match the section's eligibility and not its exclusions."
msgstr "ນັກສຶກສາຕ້ອງກົງກັບເງື່ອນໄຂຂອງກຸ່ມຮຽນ ແລະ ບໍ່ຢູ່ໃນຂໍ້ຍົກເວັ້ນ."

# key: registration.rules.duplicate_course.description
#: enums.py:111
msgid "A course can be registered only once per term."
msgstr "ວິຊາໜຶ່ງສາມາດລົງທະບຽນໄດ້ພຽງຄັ້ງດຽວຕໍ່ພາກຮຽນ."

# key: registration.rules.time_conflict.description
#: enums.py:112
msgid "Meeting times must not overlap with other registered sections."
msgstr "ເວລາຄາບຮຽນຕ້ອງບໍ່ຊ້ອນກັບກຸ່ມຮຽນອື່ນທີ່ລົງທະບຽນແລ້ວ."

# key: registration.rules.credit_limit.description
#: enums.py:113
msgid "Total credits must not exceed the credit limit that applies to the student."
msgstr "ໜ່ວຍກິດລວມຕ້ອງບໍ່ເກີນຂີດຈຳກັດໜ່ວຍກິດທີ່ນຳໃຊ້ກັບນັກສຶກສາ."

# key: registration.rules.requisites.description
#: enums.py:115
msgid "Prerequisites must be passed (equivalent courses count); corequisites may be taken in the same term."
msgstr "ຕ້ອງຜ່ານວິຊາບັງຄັບກ່ອນ (ນັບວິຊາທຽບເທົ່າ); ວິຊາບັງຄັບຮ່ວມສາມາດຮຽນໃນພາກຮຽນດຽວກັນໄດ້."

# key: registration.rules.repeat_course.description
#: enums.py:117
msgid "Whether and how often a passed course may be taken again."
msgstr "ວິຊາທີ່ຜ່ານແລ້ວສາມາດຮຽນຊ້ຳໄດ້ຫຼືບໍ່ ແລະ ຈັກຄັ້ງ."

# key: registration.rules.capacity.description
#: enums.py:118
msgid "A seat must be free (reserved seats count only for their students until released)."
msgstr "ຕ້ອງມີບ່ອນນັ່ງວ່າງ (ບ່ອນນັ່ງສະຫງວນນັບສະເພາະນັກສຶກສາທີ່ສະຫງວນໃຫ້ຈົນກວ່າຈະປ່ອຍ)."


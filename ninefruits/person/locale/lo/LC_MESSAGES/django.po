# key: people.errors.additional_program_not_offered
#: actions/additional_programs.py
msgid "This program does not accept that kind of application."
msgstr "ຫຼັກສູດນີ້ບໍ່ຮັບການສະໝັກປະເພດນັ້ນ."

# key: people.errors.additional_program_already_held
#: actions/additional_programs.py
msgid "You already follow this program."
msgstr "ທ່ານກຳລັງຮຽນຫຼັກສູດນີ້ຢູ່ແລ້ວ."

# key: people.errors.additional_program_limit
#: actions/additional_programs.py
#, python-format
msgid "You can have at most %(count)s at a time (including pending applications)."
msgstr "ທ່ານສາມາດມີໄດ້ສູງສຸດ %(count)s ລາຍການໃນເວລາດຽວກັນ (ລວມທັງໃບສະໝັກທີ່ລໍຖ້າພິຈາລະນາ)."

# key: people.errors.not_own_record
#: actions/additional_programs.py actions/status_changes.py
msgid "You can only make requests for your own record."
msgstr "ທ່ານສາມາດຍື່ນຄຳຮ້ອງໄດ້ສະເພາະບັນທຶກຂອງຕົນເອງເທົ່ານັ້ນ."

# key: people.errors.additional_program_inactive_record
#: actions/additional_programs.py
msgid "Only current students can apply."
msgstr "ສະເພາະນັກສຶກສາປັດຈຸບັນເທົ່ານັ້ນຈຶ່ງສະໝັກໄດ້."

# key: people.errors.additional_program_window_closed
#: actions/additional_programs.py
msgid "Applications for a second major or minor are not open for you now."
msgstr "ການສະໝັກວິຊາເອກທີສອງ ຫຼື ວິຊາໂທບໍ່ໄດ້ເປີດສຳລັບທ່ານໃນຂະນະນີ້."

# key: people.errors.additional_program_pending
#: actions/additional_programs.py
msgid "There is already a pending application for this program."
msgstr "ມີໃບສະໝັກທີ່ລໍຖ້າພິຈາລະນາສຳລັບຫຼັກສູດນີ້ຢູ່ແລ້ວ."

# key: people.errors.already_decided
#: actions/additional_programs.py actions/status_changes.py
msgid "This request has already been decided."
msgstr "ຄຳຮ້ອງນີ້ຖືກຕັດສິນແລ້ວ."

# key: people.errors.own_request
#: actions/additional_programs.py actions/status_changes.py
msgid "You cannot decide a request you made yourself."
msgstr "ທ່ານບໍ່ສາມາດຕັດສິນຄຳຮ້ອງທີ່ຕົນເອງຍື່ນໄດ້."

# key: people.errors.additional_program_end_invalid
#: actions/additional_programs.py
msgid "This program has already ended, or the date is before it started."
msgstr "ຫຼັກສູດນີ້ສິ້ນສຸດແລ້ວ, ຫຼື ວັນທີຢູ່ກ່ອນວັນທີເລີ່ມ."

# key: people.errors.instructor_not_current
#: actions/advisors.py
msgid "This instructor is not currently employed."
msgstr "ອາຈານທ່ານນີ້ບໍ່ໄດ້ເຮັດວຽກຢູ່ໃນປັດຈຸບັນ."

# key: people.errors.already_has_account
#: actions/invitations.py
msgid "This person already has an account."
msgstr "ບຸກຄົນນີ້ມີບັນຊີຢູ່ແລ້ວ."

# key: people.errors.email_in_use
#: actions/invitations.py
msgid "Another account uses this email."
msgstr "ບັນຊີອື່ນໃຊ້ອີເມວນີ້ຢູ່ແລ້ວ."

# key: people.invitations.invalid
#: actions/invitations.py templates/person/accept_invitation.html
msgid "This invitation link is invalid or has expired. Ask the school office for a new one."
msgstr "ລິ້ງເຊີນນີ້ບໍ່ຖືກຕ້ອງ ຫຼື ໝົດອາຍຸແລ້ວ. ກະລຸນາຕິດຕໍ່ຫ້ອງການຂອງສະຖາບັນເພື່ອຂໍລິ້ງໃໝ່."

# key: people.errors.merge_invalid
#: actions/merge.py
msgid "Choose a different person who has not been merged."
msgstr "ກະລຸນາເລືອກບຸກຄົນອື່ນທີ່ຍັງບໍ່ໄດ້ຖືກລວມ."

# key: people.errors.merge_two_instructors
#: actions/merge.py
msgid "Both people have instructor records. Merge the instructor records first."
msgstr "ບຸກຄົນທັງສອງມີບັນທຶກອາຈານ. ກະລຸນາລວມບັນທຶກອາຈານກ່ອນ."

# key: people.errors.merge_two_open_applications
#: actions/merge.py
msgid "Both people have an open application in the same admission cycle. Withdraw one first."
msgstr "ບຸກຄົນທັງສອງມີໃບສະໝັກທີ່ຍັງເປີດຢູ່ໃນຮອບຮັບເຂົ້າຮຽນດຽວກັນ. ກະລຸນາຖອນໃບໜຶ່ງກ່ອນ."

# key: people.errors.type_not_applicable
#: actions/status_changes.py
#, python-format
msgid "This change does not apply to a student who is %(status)s."
msgstr "ການປ່ຽນແປງນີ້ບໍ່ສາມາດນຳໃຊ້ກັບນັກສຶກສາທີ່ມີສະຖານະ %(status)s."

# key: people.errors.not_requestable
#: actions/status_changes.py
msgid "Students cannot request this type of change."
msgstr "ນັກສຶກສາບໍ່ສາມາດຂໍການປ່ຽນແປງປະເພດນີ້ໄດ້."

# key: people.errors.request_pending
#: actions/status_changes.py
msgid "There is already a pending request for this record."
msgstr "ມີຄຳຮ້ອງທີ່ລໍຖ້າພິຈາລະນາສຳລັບບັນທຶກນີ້ຢູ່ແລ້ວ."

# key: people.errors.status_changed_meanwhile
#: actions/status_changes.py
msgid "The student's status changed after the request was made. Reject it and ask for a new request."
msgstr "ສະຖານະຂອງນັກສຶກສາປ່ຽນແປງຫຼັງຈາກຍື່ນຄຳຮ້ອງ. ກະລຸນາປະຕິເສດ ແລະ ຂໍໃຫ້ຍື່ນຄຳຮ້ອງໃໝ່."

# key: people.errors.person_merged
#: actions/students.py
msgid "This person was merged into another person. Use that person instead."
msgstr "ບຸກຄົນນີ້ຖືກລວມເຂົ້າກັບບຸກຄົນອື່ນແລ້ວ. ກະລຸນາໃຊ້ບຸກຄົນນັ້ນແທນ."

#: actions/students.py
msgid "Enter a valid date."
msgstr "ກະລຸນາປ້ອນວັນທີທີ່ຖືກຕ້ອງ."

# key: people.errors.program_not_effective
#: actions/students.py
msgid "The program is not in effect on the admission date."
msgstr "ຫຼັກສູດນີ້ບໍ່ມີຜົນໃນວັນທີຮັບເຂົ້າຮຽນ."


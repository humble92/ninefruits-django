msgstr "该学籍已有待处理的申请。"

# key: people.errors.status_changed_meanwhile
#: actions/status_changes.py
msgid ""
"The student's status changed after the request was made. Reject it and ask "
"for a new request."
msgstr "申请后学籍状态已改变。请驳回并让学生重新申请。"

# key: people.errors.person_merged
#: actions/students.py
msgid "This person was merged into another person. Use that person instead."
msgstr "该人员已合并至其他人员，请使用合并后的人员。"


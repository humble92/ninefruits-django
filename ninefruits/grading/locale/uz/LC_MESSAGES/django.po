# key: grading.errors.nothing_submitted
#: ninefruits/grading/actions/finalize_grades.py
msgid "There are no submitted grades."
msgstr "Topshirilgan baholar yoʻq."

# key: grading.errors.not_finalized
#: ninefruits/grading/actions/manage_grade_changes.py
msgid "Only a final grade needs a change request."
msgstr "Faqat yakuniy baho uchun oʻzgartirish soʻrovi kerak."

# key: grading.errors.new_grade_required
#: ninefruits/grading/actions/manage_grade_changes.py ninefruits/grading/views/portal.py
msgid "Enter the new score or grade."
msgstr "Yangi ball yoki bahoni kiriting."

# key: grading.errors.same_grade
#: ninefruits/grading/actions/manage_grade_changes.py
msgid "The new grade is the current grade."
msgstr "Yangi baho joriy baho bilan bir xil."

# key: grading.errors.request_pending
#: ninefruits/grading/actions/manage_grade_changes.py
msgid "A change request for this grade is already open."
msgstr "Bu baho boʻyicha oʻzgartirish soʻrovi allaqachon ochiq."

# key: grading.errors.request_decided
#: ninefruits/grading/actions/manage_grade_changes.py ninefruits/grading/actions/manage_method_requests.py
msgid "The request is already decided."
msgstr "Soʻrov boʻyicha qaror allaqachon qabul qilingan."

# key: grading.errors.own_request
#: ninefruits/grading/actions/manage_grade_changes.py
msgid "You cannot decide your own request."
msgstr "Oʻz soʻrovingiz boʻyicha qaror qabul qila olmaysiz."

# key: grading.errors.same_method
#: ninefruits/grading/actions/manage_method_requests.py
msgid "The section already uses that evaluation method."
msgstr "Fan guruhi allaqachon shu baholash usulidan foydalanadi."

# key: grading.errors.method_request_pending
#: ninefruits/grading/actions/manage_method_requests.py
msgid "A change request for this section is already waiting."
msgstr "Bu fan guruhi uchun oʻzgartirish soʻrovi allaqachon kutilmoqda."

# key: grading.errors.method_has_grades
#: ninefruits/grading/actions/manage_method_requests.py
msgid "Grades are already entered; the evaluation method cannot change."
msgstr "Baholar allaqachon kiritilgan; baholash usulini oʻzgartirib boʻlmaydi."

# key: grading.errors.scale_fixed
#: ninefruits/grading/actions/save_grade_scale.py
msgid "The grade scale is fixed at installation and cannot change."
msgstr "Baholash shkalasi oʻrnatishda belgilangan va oʻzgarmaydi."

# key: grading.errors.not_editable
#: ninefruits/grading/actions/save_grades.py
msgid "Some grades can no longer be changed here."
msgstr "Baʼzi baholarni bu yerda endi oʻzgartirib boʻlmaydi."

# key: grading.errors.over_caps
#: ninefruits/grading/actions/save_grades.py
msgid "The grades are outside the institution's grade caps. Adjust them, or ask the office."
msgstr "Baholar muassasaning baho chegaralaridan tashqarida. Ularni tuzating yoki oʻquv boʻlimiga murojaat qiling."

# key: grading.errors.exception_reason_required
#: ninefruits/grading/actions/save_grades.py
msgid "Submitting outside the grade caps needs a reason."
msgstr "Baho chegaralaridan tashqari topshirish uchun sabab kerak."

# key: grading.errors.missing_grades
#: ninefruits/grading/actions/save_grades.py
#, python-format
msgid "%(count)s student(s) have no grade yet."
msgstr "%(count)s ta talabaga hali baho qoʻyilmagan."

# key: grading.errors.entry_closed
#: ninefruits/grading/actions/save_grades.py
msgid "Grade entry is not open for this section."
msgstr "Bu fan guruhi uchun baho kiritish ochiq emas."


msgid "Enter a reason."
msgstr "Sababini kiriting."

# key: grading.errors.term_not_published
#: ninefruits/grading/actions/close_term.py
msgid "Only a published term closes."
msgstr "Faqat eʼlon qilingan semestrni yopish mumkin."


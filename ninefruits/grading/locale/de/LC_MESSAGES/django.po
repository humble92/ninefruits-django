msgstr "%(count)s Studierende haben noch keine Note."

# key: grading.errors.entry_closed
#: ninefruits/grading/actions/save_grades.py
msgid "Grade entry is not open for this section."
msgstr "Die Noteneingabe für diesen Kurs ist nicht offen."


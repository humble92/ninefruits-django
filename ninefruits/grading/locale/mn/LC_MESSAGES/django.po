# key: grading.errors.method_request_pending
#: ninefruits/grading/actions/manage_method_requests.py
msgid "A change request for this section is already waiting."
msgstr "Энэ бүлэгт өөрчлөлтийн хүсэлт аль хэдийн хүлээгдэж байна."

# key: grading.errors.method_has_grades
#: ninefruits/grading/actions/manage_method_requests.py

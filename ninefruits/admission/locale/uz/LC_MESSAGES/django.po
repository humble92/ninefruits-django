#: ninefruits/admission/actions/applications.py
msgid "This cycle is not taking applications."
msgstr "Bu mavsumda arizalar qabul qilinmayapti."

# key: admissions.errors.already_applied
#: ninefruits/admission/actions/applications.py
msgid "You already have an open application in this cycle."
msgstr "Bu mavsumda sizda ochiq ariza allaqachon bor."

# key: admissions.errors.program_not_offered
#: ninefruits/admission/actions/applications.py
msgid "This program is not offered in the cycle."
msgstr "Bu dastur ushbu mavsumda taklif etilmaydi."

# key: admissions.errors.not_draft
#: ninefruits/admission/actions/applications.py
msgid "Only applications that have not been submitted can be changed."
msgstr "Faqat topshirilmagan arizalarni oʻzgartirish mumkin."


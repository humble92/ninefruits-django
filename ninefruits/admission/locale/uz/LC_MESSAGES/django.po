msgstr "Ismingiz va tugʻilgan sanangiz oʻquv boʻlimi tomonidan yuritiladi."

# key: admissions.errors.document_type_not_requested
#: ninefruits/admission/actions/applications.py
msgid "This cycle does not ask for this document."
msgstr "Bu mavsumda ushbu hujjat soʻralmaydi."

# key: admissions.errors.document_too_large
#: ninefruits/admission/actions/applications.py
#, python-format
msgid "The file is larger than %(mb)s MB."
msgstr "Fayl hajmi %(mb)s MB dan katta."


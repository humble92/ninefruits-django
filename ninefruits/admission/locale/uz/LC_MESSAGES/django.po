#: ninefruits/admission/actions/applications.py
msgid "This field is required to submit."
msgstr "Topshirish uchun bu maydon majburiy."

# key: admissions.errors.documents_missing
#: ninefruits/admission/actions/applications.py
#, python-format
msgid "Upload the required documents: %(documents)s."
msgstr "Majburiy hujjatlarni yuklang: %(documents)s."

# key: admissions.errors.invalid_transition
#: ninefruits/admission/actions/applications.py ninefruits/admission/actions/decisions.py
msgid "This is not possible in the application's current status."
msgstr "Arizaning hozirgi holatida bu mumkin emas."

# key: admissions.errors.reason_required
#: ninefruits/admission/actions/decisions.py
msgid "Give the reason when recording a response for the applicant."
msgstr "Abituriyent nomidan javobni qayd etayotganda sababini koʻrsating."

# key: admissions.errors.no_open_offer
#: ninefruits/admission/actions/decisions.py
msgid "There is no offer to answer."
msgstr "Javob beriladigan taklif yoʻq."

# key: admissions.errors.offer_expired
#: ninefruits/admission/actions/decisions.py
msgid "The deadline to accept this offer has passed. Contact the admissions office."
msgstr "Bu taklifni qabul qilish muddati oʻtgan. Qabul komissiyasiga murojaat qiling."

# key: admissions.errors.not_ready_to_matriculate
#: ninefruits/admission/actions/matriculation.py
msgid "Only accepted offers without a student record can be matriculated."
msgstr "Faqat talaba yozuvi boʻlmagan qabul qilingan takliflar boʻyicha talabalikka qabul qilish mumkin."


# key: admissions.errors.no_person
#: actions/applications.py
msgid "This account is not linked to a person."
msgstr "ບັນຊີນີ້ບໍ່ໄດ້ເຊື່ອມໂຍງກັບບຸກຄົນ."

# key: admissions.errors.cycle_closed
#: actions/applications.py
msgid "This cycle is not taking applications."
msgstr "ຮອບນີ້ບໍ່ໄດ້ຮັບໃບສະໝັກ."

# key: admissions.errors.already_applied
#: actions/applications.py
msgid "You already have an open application in this cycle."
msgstr "ທ່ານມີໃບສະໝັກທີ່ຍັງເປີດຢູ່ໃນຮອບນີ້ແລ້ວ."

# key: admissions.errors.program_not_offered
#: actions/applications.py
msgid "This program is not offered in the cycle."
msgstr "ຫຼັກສູດນີ້ບໍ່ໄດ້ເປີດຮັບໃນຮອບນີ້."

# key: admissions.errors.not_draft
#: actions/applications.py
msgid "Only applications that have not been submitted can be changed."
msgstr "ແກ້ໄຂໄດ້ສະເພາະໃບສະໝັກທີ່ຍັງບໍ່ໄດ້ສົ່ງ."

#: actions/applications.py
msgid "Select a valid choice."
msgstr "ກະລຸນາເລືອກຕົວເລືອກທີ່ຖືກຕ້ອງ."

#: actions/applications.py
msgid "The birth date must be a date before today."
msgstr "ວັນເດືອນປີເກີດຕ້ອງເປັນວັນທີກ່ອນມື້ນີ້."

# key: admissions.errors.identity_locked
#: actions/applications.py
msgid "Your name and birth date are kept by the registrar's office."
msgstr "ຊື່ ແລະ ວັນເດືອນປີເກີດຂອງທ່ານຖືກຮັກສາໂດຍຫ້ອງການທະບຽນ."

# key: admissions.errors.document_type_not_requested
#: actions/applications.py
msgid "This cycle does not ask for this document."
msgstr "ຮອບນີ້ບໍ່ຕ້ອງການເອກະສານນີ້."

# key: admissions.errors.document_too_large
#: actions/applications.py
#, python-format
msgid "The file is larger than %(mb)s MB."
msgstr "ໄຟລ໌ໃຫຍ່ກວ່າ %(mb)s MB."

# key: admissions.errors.document_type_invalid
#: actions/applications.py
msgid "Upload a PDF, JPEG or PNG file."
msgstr "ກະລຸນາອັບໂຫຼດໄຟລ໌ PDF, JPEG ຫຼື PNG."

# key: admissions.errors.required_field
#: actions/applications.py
msgid "This field is required to submit."
msgstr "ຕ້ອງຕື່ມຊ່ອງນີ້ເພື່ອສົ່ງ."

# key: admissions.errors.documents_missing
#: actions/applications.py
#, python-format
msgid "Upload the required documents: %(documents)s."
msgstr "ກະລຸນາອັບໂຫຼດເອກະສານທີ່ຈຳເປັນ: %(documents)s."

# key: admissions.errors.invalid_transition
#: actions/applications.py actions/decisions.py
msgid "This is not possible in the application's current status."
msgstr "ບໍ່ສາມາດເຮັດໄດ້ໃນສະຖານະປັດຈຸບັນຂອງໃບສະໝັກ."

# key: admissions.errors.reason_required
#: actions/decisions.py
msgid "Give the reason when recording a response for the applicant."
msgstr "ກະລຸນາລະບຸເຫດຜົນເມື່ອບັນທຶກຄຳຕອບແທນຜູ້ສະໝັກ."

# key: admissions.errors.no_open_offer
#: actions/decisions.py
msgid "There is no offer to answer."
msgstr "ບໍ່ມີການຕອບຮັບໃຫ້ຕອບ."

# key: admissions.errors.offer_expired
#: actions/decisions.py
msgid "The deadline to accept this offer has passed. Contact the admissions office."
msgstr "ກຳນົດຕອບຮັບໄດ້ຜ່ານໄປແລ້ວ. ກະລຸນາຕິດຕໍ່ຫ້ອງການຮັບເຂົ້າຮຽນ."

# key: admissions.errors.not_ready_to_matriculate
#: actions/matriculation.py
msgid "Only accepted offers without a student record can be matriculated."
msgstr "ສ້າງບັນທຶກນັກສຶກສາໄດ້ສະເພາະຜູ້ທີ່ຕອບຮັບແລ້ວ ແລະ ຍັງບໍ່ມີບັນທຶກນັກສຶກສາ."

# key: admissions.errors.registration_closed
#: actions/registration.py forms.py
msgid "Creating an account is not available. Contact the admissions office."
msgstr "ບໍ່ສາມາດສ້າງບັນຊີໄດ້ໃນຂະນະນີ້. ກະລຸນາຕິດຕໍ່ຫ້ອງການຮັບເຂົ້າຮຽນ."

#: actions/registration.py
msgid "The email has already been taken."
msgstr "ອີເມວນີ້ຖືກໃຊ້ແລ້ວ."


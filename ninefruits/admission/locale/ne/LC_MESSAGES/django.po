#: ninefruits/admission/actions/applications.py
msgid "You already have an open application in this cycle."
msgstr "यस चरणमा तपाईंको खुला आवेदन पहिले नै छ।"

# key: admissions.errors.program_not_offered
#: ninefruits/admission/actions/applications.py
msgid "This program is not offered in the cycle."

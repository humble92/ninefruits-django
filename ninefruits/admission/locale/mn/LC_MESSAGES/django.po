# key: admissions.errors.no_person
#: ninefruits/admission/actions/applications.py
msgid "This account is not linked to a person."
msgstr "Энэ бүртгэл хувь хүнтэй холбогдоогүй байна."

# key: admissions.errors.cycle_closed
#: ninefruits/admission/actions/applications.py
msgid "This cycle is not taking applications."
msgstr "Энэ элсэлтийн үед өргөдөл хүлээн авахгүй байна."

# key: admissions.errors.already_applied
#: ninefruits/admission/actions/applications.py
msgid "You already have an open application in this cycle."
msgstr "Та энэ элсэлтийн үед шийдвэрлэгдээгүй өргөдөлтэй байна."

# key: admissions.errors.program_not_offered
#: ninefruits/admission/actions/applications.py

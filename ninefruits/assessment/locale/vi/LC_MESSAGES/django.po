msgstr "Dành cho loại kỳ thi không có phần thi. Nếu có phần thi, điểm tối đa là tổng các phần."

# key: assessment.help.pass_score
#: ninefruits/assessment/models/types.py
msgid "Total needed to pass. A session can override it."
msgstr "Tổng điểm cần để đạt. Mỗi đợt thi có thể đặt giá trị riêng."


# key: assessment.fields.min_score
#: ninefruits/assessment/models/types.py
msgid "Minimum to pass"
msgstr "Oʻtish uchun minimal ball"

# key: assessment.help.min_score
#: ninefruits/assessment/models/types.py
msgid "Below this the student fails whatever the total."
msgstr "Bundan past boʻlsa, jami balldan qatʼi nazar talaba oʻtmaydi."


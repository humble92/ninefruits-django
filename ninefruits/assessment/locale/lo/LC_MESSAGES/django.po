# key: assessment.errors.pass_score_published
#: actions/change_session_pass_score.py:39
msgid "The results are published: the pass score cannot change. Use correction requests."
msgstr "ຜົນສອບປະກາດແລ້ວ: ບໍ່ສາມາດປ່ຽນຄະແນນຜ່ານໄດ້. ກະລຸນາໃຊ້ການຂໍແກ້ໄຂຜົນສອບ."

# key: assessment.errors.not_locked
#: actions/correct_assessment_result.py:44 actions/correct_assessment_result.py:77
msgid "This result is not published; enter it directly."
msgstr "ຜົນສອບນີ້ຍັງບໍ່ໄດ້ປະກາດ; ກະລຸນາປ້ອນໂດຍກົງ."

# key: assessment.errors.correction_pending
#: actions/correct_assessment_result.py:47
msgid "A correction request is already pending for this result."
msgstr "ມີການຂໍແກ້ໄຂຜົນສອບນີ້ລໍຖ້າພິຈາລະນາຢູ່ແລ້ວ."

# key: grading.errors.request_decided
#: actions/correct_assessment_result.py:140
msgid "The request is already decided."
msgstr "ຄຳຂໍນີ້ຖືກພິຈາລະນາແລ້ວ."

# key: assessment.errors.own_correction
#: actions/correct_assessment_result.py:142
msgid "You cannot decide your own correction request."

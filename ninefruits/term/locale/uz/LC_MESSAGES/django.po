msgstr "Mashgʻulotlar davri oʻz semestri ichida boʻlishi kerak (%(start)s - %(end)s)."

#: ninefruits/term/admin.py
msgid "The full-term session belongs to the term and cannot be deleted."
msgstr "Butun semestr mashgʻulotlar davri semestrga tegishli va uni oʻchirib boʻlmaydi."


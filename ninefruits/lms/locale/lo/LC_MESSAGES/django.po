#: actions/deliver.py
msgid "Each score must be a number from 0 to 100."
msgstr "ຄະແນນແຕ່ລະອັນຕ້ອງເປັນຕົວເລກແຕ່ 0 ຫາ 100."

#: actions/deliver.py
msgid "Unknown operation."

#: actions/deliver.py
msgid "This step is already finished."
msgstr "ຂັ້ນຕອນນີ້ສິ້ນສຸດແລ້ວ."

#: actions/deliver.py
msgid "The operation does not match the sync log entry."
msgstr "ການດຳເນີນການບໍ່ກົງກັບບັນທຶກການຊິງ."

#: actions/deliver.py
msgid "The section is not linked to this platform."
msgstr "ກຸ່ມຮຽນນີ້ບໍ່ໄດ້ເຊື່ອມຕໍ່ກັບແພລັດຟອມນີ້."

#: actions/deliver.py
msgid "Send an object of user id to score."
msgstr "ໃຫ້ສົ່ງ object ຂອງ user id ກັບຄະແນນ."

#: actions/deliver.py
msgid "No section is linked to this course."

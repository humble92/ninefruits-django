DJANGO_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ninefruits
DB_TEST_DATABASE=test_ninefruits
DB_USERNAME=app_runtime
DB_PASSWORD=secret
DB_MIGRATOR_USERNAME=app_migrator
DB_MIGRATOR_PASSWORD=secret
DB_REPORTING_PASSWORD=secret
# Superuser: only for creating databases (tests, docker/pgsql init).
DB_SUPERUSER_USERNAME=postgres
DB_SUPERUSER_PASSWORD=postgres
DB_POOL=false

REDIS_URL=redis://127.0.0.1:6379/0
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
GOTENBERG_URL=http://127.0.0.1:3000

# uv run manage.py pii_generate_key
PII_ENCRYPTION_KEY=
PII_PREVIOUS_KEYS=
PII_HASH_KEY=

#: ninefruits/i18n/vendor_strings.py
msgid "Reset My Password"
msgstr "ຕັ້ງລະຫັດຜ່ານຂອງຂ້ອຍໃໝ່"

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Please contact us if you have any trouble resetting your password."
msgstr "ກະລຸນາຕິດຕໍ່ພວກເຮົາ ຖ້າທ່ານມີບັນຫາໃນການຕັ້ງລະຫັດຜ່ານໃໝ່."

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "We have sent you an email. If you have not received it please check your spam folder. Otherwise contact us if you do not receive it in a few minutes."
msgstr "ພວກເຮົາໄດ້ສົ່ງອີເມວໃຫ້ທ່ານແລ້ວ. ຖ້າທ່ານບໍ່ໄດ້ຮັບ, ກະລຸນາກວດເບິ່ງໂຟນເດີສະແປມ. ຖ້າຍັງບໍ່ໄດ້ຮັບພາຍໃນສອງສາມນາທີ, ກະລຸນາຕິດຕໍ່ພວກເຮົາ."

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Bad Token"
msgstr "ໂທເຄັນບໍ່ຖືກຕ້ອງ"

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
#, python-format
msgid "The password reset link was invalid, possibly because it has already been used.  Please request a <a href=\"%(passwd_reset_url)s\">new password reset</a>."
msgstr "ລິ້ງຕັ້ງລະຫັດຜ່ານໃໝ່ບໍ່ຖືກຕ້ອງ, ອາດເປັນເພາະຖືກໃຊ້ໄປແລ້ວ. ກະລຸນາ<a href=\"%(passwd_reset_url)s\">ຂໍຕັ້ງລະຫັດຜ່ານໃໝ່</a>ອີກຄັ້ງ."

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Your password is now changed."
msgstr "ລະຫັດຜ່ານຂອງທ່ານຖືກປ່ຽນແລ້ວ."

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Change Password"
msgstr "ປ່ຽນລະຫັດຜ່ານ"

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Current Password"
msgstr "ລະຫັດຜ່ານປັດຈຸບັນ"

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "New Password"
msgstr "ລະຫັດຜ່ານໃໝ່"

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "New Password (again)"
msgstr "ລະຫັດຜ່ານໃໝ່ (ອີກຄັ້ງ)"

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "You must type the same password each time."
msgstr "ທ່ານຕ້ອງພິມລະຫັດຜ່ານດຽວກັນທຸກຄັ້ງ."

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Please type your current password."
msgstr "ກະລຸນາພິມລະຫັດຜ່ານປັດຈຸບັນ."

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Incorrect password."
msgstr "ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ."

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Invalid or expired key."
msgstr "ຄີບໍ່ຖືກຕ້ອງ ຫຼື ໝົດອາຍຸແລ້ວ."

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "The password reset token was invalid."
msgstr "ໂທເຄັນຕັ້ງລະຫັດຜ່ານໃໝ່ບໍ່ຖືກຕ້ອງ."

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Be patient, you are sending too many requests."
msgstr "ກະລຸນາລໍຖ້າ, ທ່ານສົ່ງຄຳຮ້ອງຂໍຫຼາຍເກີນໄປ."

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Two-Factor Authentication"
msgstr "ການຢືນຢັນສອງຂັ້ນຕອນ"

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Your account is protected by two-factor authentication. Please enter an authenticator code:"
msgstr "ບັນຊີຂອງທ່ານຖືກປ້ອງກັນດ້ວຍການຢືນຢັນສອງຂັ້ນຕອນ. ກະລຸນາປ້ອນລະຫັດຈາກແອັບຢືນຢັນ:"

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Authenticator code"
msgstr "ລະຫັດຈາກແອັບຢືນຢັນ"

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Code"
msgstr "ລະຫັດ"

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Incorrect code."
msgstr "ລະຫັດບໍ່ຖືກຕ້ອງ."

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Alternative options"
msgstr "ທາງເລືອກອື່ນ"

# vendor: Django/allauth/unfold
#: ninefruits/i18n/vendor_strings.py
msgid "Use authenticator app or code"
msgstr "ໃຊ້ແອັບຢືນຢັນ ຫຼື ລະຫັດ"

